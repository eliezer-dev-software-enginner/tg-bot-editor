{
  "version": 1,
  "name": "Bot unificado",
  "flows": [
    {
      "id": "g1-news",
      "title": "Publicar notícias do G1",
      "trigger": "INTERVAL",
      "pattern": "180",
      "script": "return G1NewsAction.run();",
      "x": 48,
      "y": 54,
      "targetChatEnv": "TG_BOT_G1_CHAT"
    },
    {
      "id": "start",
      "title": "Boas-vindas",
      "trigger": "COMMAND",
      "pattern": "/start",
      "script": "return \"Olá! Este bot reúne notícias, ROMs e anúncios. Use /ads para administrar anúncios.\";",
      "x": 48,
      "y": 194
    },
    {
      "id": "daily-roms",
      "title": "Publicar ROM do catálogo",
      "trigger": "DAILY",
      "pattern": "09:00,15:00,21:00",
      "targetChatEnv": "TG_BOT_ROMS_CHAT",
      "script": "return RomPostAction.run();",
      "x": 380,
      "y": 54
    },
    {
      "id": "ads-menu",
      "title": "Anúncios: menu",
      "trigger": "COMMAND",
      "pattern": "/ads",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 335
    },
    {
      "id": "ads-new",
      "title": "Anúncios: criar",
      "trigger": "COMMAND",
      "pattern": "/novo",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 335
    },
    {
      "id": "ads-save",
      "title": "Anúncios: salvar",
      "trigger": "COMMAND",
      "pattern": "/save",
      "script": "return GenshinAdsAction.run(context);",
      "x": 708,
      "y": 335
    },
    {
      "id": "ads-list",
      "title": "Anúncios: listar",
      "trigger": "COMMAND",
      "pattern": "/listar",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 465
    },
    {
      "id": "ads-publish",
      "title": "Anúncios: publicar",
      "trigger": "COMMAND",
      "pattern": "/publicar",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 465
    },
    {
      "id": "ads-config",
      "title": "Anúncios: configurar",
      "trigger": "COMMAND",
      "pattern": "/config",
      "script": "return GenshinAdsAction.run(context);",
      "x": 708,
      "y": 465
    },
    {
      "id": "ads-addchat",
      "title": "Anúncios: adicionar canal",
      "trigger": "COMMAND",
      "pattern": "/addchat",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 595
    },
    {
      "id": "ads-removechat",
      "title": "Anúncios: remover canal",
      "trigger": "COMMAND",
      "pattern": "/removechat",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 595
    },
    {
      "id": "ads-callback",
      "title": "Anúncios: botões",
      "trigger": "CALLBACK",
      "pattern": "ads:*",
      "script": "return GenshinAdsAction.run(context);",
      "x": 708,
      "y": 595
    },
    {
      "id": "ads-text",
      "title": "Anúncios: respostas",
      "trigger": "TEXT",
      "pattern": "*",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 725
    },
    {
      "id": "ads-photo",
      "title": "Anúncios: fotos",
      "trigger": "PHOTO",
      "pattern": "*",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 725
    },
    {
      "id": "ads-tick",
      "title": "Anúncios: agendamento",
      "trigger": "INTERVAL",
      "pattern": "1",
      "script": "return GenshinAdsAction.tick();",
      "x": 708,
      "y": 725,
      "targetChatEnv": ""
    }
  ]
}
