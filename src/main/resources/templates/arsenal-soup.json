{
  "version": 1,
  "name": "Bot unificado",
  "flows": [
    {
      "id": "g1-news",
      "title": "Publicar notícias do G1",
      "trigger": "INTERVAL",
      "pattern": "180",
      "script": "return G1NewsAction.run();",
      "x": 48,
      "y": 54,
      "targetChatEnv": "TG_BOT_G1_CHAT"
    },
    {
      "id": "start",
      "title": "Boas-vindas",
      "trigger": "COMMAND",
      "pattern": "/start",
      "script": "return \"Olá! Este bot reúne os fluxos publicados no TG-bot Editor.\";",
      "x": 48,
      "y": 194
    },
    {
      "id": "daily-roms",
      "title": "Publicar ROM do catálogo",
      "trigger": "DAILY",
      "pattern": "09:00,15:00,21:00",
      "targetChatEnv": "TG_BOT_ROMS_CHAT",
      "script": "return RomPostAction.run();",
      "x": 380,
      "y": 54
    }
  ]
}
