{
  "version": 1,
  "name": "meu-primeiro-projeto",
  "flows": [
    {
      "id": "g1-news",
      "title": "Publicar notícias do G1",
      "trigger": "INTERVAL",
      "pattern": "180",
      "script": "return G1NewsAction.run();",
      "x": 48,
      "y": 54,
      "targetChatEnv": "TG_BOT_G1_CHAT"
    },
    {
      "id": "start",
      "title": "Boas-vindas",
      "trigger": "COMMAND",
      "pattern": "/start",
      "script": "return \"Olá! Este bot reúne notícias e anúncios. Use /ads para administrar anúncios.\";",
      "x": 48,
      "y": 194,
      "description": "Mostra uma mensagem de boas-vindas e indica como usar o bot."
    },
    {
      "id": "ads-menu",
      "title": "Anúncios: menu",
      "trigger": "COMMAND",
      "pattern": "/ads",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 335,
      "description": "Abre o menu de gerenciamento de anúncios."
    },
    {
      "id": "ads-new",
      "title": "Anúncios: criar",
      "trigger": "COMMAND",
      "pattern": "/novo",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 335,
      "description": "Inicia o cadastro de um novo anúncio."
    },
    {
      "id": "ads-save",
      "title": "Anúncios: salvar",
      "trigger": "COMMAND",
      "pattern": "/save",
      "script": "return GenshinAdsAction.run(context);",
      "x": 708,
      "y": 335,
      "description": "Salva o anúncio em edição."
    },
    {
      "id": "ads-list",
      "title": "Anúncios: listar",
      "trigger": "COMMAND",
      "pattern": "/listar",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 465,
      "description": "Lista os anúncios cadastrados."
    },
    {
      "id": "ads-publish",
      "title": "Anúncios: publicar",
      "trigger": "COMMAND",
      "pattern": "/publicar",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 465,
      "description": "Publica um anúncio nos grupos, tópicos e canais configurados."
    },
    {
      "id": "ads-config",
      "title": "Anúncios: configurar",
      "trigger": "COMMAND",
      "pattern": "/config",
      "script": "return GenshinAdsAction.run(context);",
      "x": 708,
      "y": 465,
      "description": "Mostra a configuração de anúncios e canais."
    },
    {
      "id": "ads-topic",
      "title": "Anúncios: identificar tópico",
      "trigger": "COMMAND",
      "pattern": "/topic",
      "script": "return GenshinAdsAction.run(context);",
      "x": 1038,
      "y": 465,
      "description": "Mostra os IDs do grupo e do tópico atual para configurar um destino."
    },
    {
      "id": "ads-addchat",
      "title": "Anúncios: adicionar canal",
      "trigger": "COMMAND",
      "pattern": "/addchat",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 595,
      "description": "Adiciona um grupo ou canal, opcionalmente dentro de um tópico."
    },
    {
      "id": "ads-removechat",
      "title": "Anúncios: remover canal",
      "trigger": "COMMAND",
      "pattern": "/removechat",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 595,
      "description": "Remove um grupo, canal ou tópico de destino."
    },
    {
      "id": "ads-callback",
      "title": "Anúncios: botões",
      "trigger": "CALLBACK",
      "pattern": "ads:*",
      "script": "return GenshinAdsAction.run(context);",
      "x": 708,
      "y": 595
    },
    {
      "id": "ads-text",
      "title": "Anúncios: respostas",
      "trigger": "TEXT",
      "pattern": "*",
      "script": "return GenshinAdsAction.run(context);",
      "x": 48,
      "y": 725
    },
    {
      "id": "ads-photo",
      "title": "Anúncios: fotos",
      "trigger": "PHOTO",
      "pattern": "*",
      "script": "return GenshinAdsAction.run(context);",
      "x": 378,
      "y": 725
    },
    {
      "id": "ads-tick",
      "title": "Anúncios: agendamento",
      "trigger": "INTERVAL",
      "pattern": "1",
      "script": "return GenshinAdsAction.tick();",
      "x": 708,
      "y": 725,
      "targetChatEnv": ""
    }
  ]
}
